{
  "name": "vmf-guiding",
  "title": "Guiding distribution (vMF)",
  "description": "A von Mises-Fisher mixture on the unit sphere: density as colour, lobes as points. With a reference, learned and reference side by side.",
  "accepts": [
    "custom:guiding/vmf"
  ],
  "inputs": "compare",
  "webgl": true,
  "view": true,
  "icon": "globe",
  "settings": [
    {
      "key": "exposure",
      "type": "slider",
      "label": "Exposure",
      "min": 0.1,
      "max": 8,
      "step": 0.1,
      "default": 1,
      "tab": "display",
      "section": "Appearance",
      "help": "Scales the density before colouring."
    },
    {
      "key": "colormap",
      "type": "colormap",
      "label": "Colormap",
      "default": "viridis",
      "tab": "display",
      "section": "Appearance"
    },
    {
      "key": "pointSize",
      "type": "slider",
      "label": "Lobe size",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 6,
      "tab": "display",
      "section": "Overlays",
      "help": "Size of the lobe markers (0 hides them)."
    },
    {
      "key": "wireframe",
      "type": "switch",
      "label": "Wireframe",
      "default": false,
      "tab": "display",
      "section": "Overlays",
      "help": "Draw the sphere's mesh lines."
    },
    {
      "key": "maxLobes",
      "type": "number",
      "label": "Max lobes",
      "min": 1,
      "max": 256,
      "step": 1,
      "default": 64,
      "tab": "values",
      "section": "Series",
      "help": "Evaluate only the heaviest lobes."
    }
  ],
  "imports": {
    "three/addons/controls/OrbitControls.js": "./vendor/three/addons/controls/OrbitControls.js"
  }
}
