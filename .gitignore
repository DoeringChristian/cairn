.ruff_cache/

# Virtual envs
.venv/
venv/
env/

# Frontend build deps (the viewer is its own distribution: packages/cairn-ui/)
packages/cairn-ui/node_modules/
packages/cairn-ui/*.tsbuildinfo
# The built bundle lives at packages/cairn-ui/cairn_ui/_dist and IS COMMITTED,
# so `pip install cairn-ui` never needs Node. Named `_dist` rather than `dist`
# so the blanket `dist/` rule above simply does not match it — no negation, and
# it reads as package data.
# Generated browser-test bundles (esbuild output for engine/__tests__/*.browser.ts
# harnesses run via claude-in-chrome) — regenerate from source, never committed.
packages/cairn-ui/src/**/__tests__/*.browser.bundle.js
# Real compiled Tailwind CSS copied into a __tests__/ dir so a bare
# claude-in-chrome harness page gets real `h-full`/`flex-1`/`w-full` layout
# (see media-compare/__tests__/gpu-compare-geometry.browser.ts's doc comment)
# — regenerate via `cp dist/plot-inline/style.css`, never committed.
packages/cairn-ui/src/**/__tests__/harness-style.css

# Cairn runtime
.cairn/
~/.cache/cairn/

